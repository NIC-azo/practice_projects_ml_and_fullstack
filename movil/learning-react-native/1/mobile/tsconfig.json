{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    /* 🧬 Soporte para Decoradores */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "ignoreDeprecations": "6.0",
    
    /* 🛣️ Configuración de Alias de Rutas (@/*) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
